+inline TrafficSpec ScenarioRunner::GetRunTrafficSpec(int useCase) const {
+    TrafficSpec spec = GetTrafficSpec(useCase);
+    if (useCase == UC_RTSA && m_cfg.studySensorUlMbps > 0) {
+        int sensors = 0;
+        for (int ue = 0; ue < m_cfg.ueNum; ++ue) {
+            sensors += m_cfg.assignUseCase(ue) == UC_RTSA;
+        }
+        NS_ABORT_MSG_IF(sensors == 0, "Study background UL override requires Sensor UEs");
+        spec.ul_mbps_target = m_cfg.studySensorUlMbps / sensors;
+        spec.ul_iv = Seconds(spec.ul_pkt * 8.0 / (spec.ul_mbps_target * 1e6));
+        NS_ABORT_MSG_IF(spec.ul_iv.IsZero(), "Study background interval is below time resolution");
+    }
+    return spec;
+}
